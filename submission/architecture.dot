digraph G { rankdir=TB; graph [bgcolor="white", pad="0.3", nodesep="0.35", ranksep="0.5", fontname="Arial", label="GlycoTwin AI — Digital Twin Prototype Architecture", labelloc=t, fontsize=20]; node [shape=box, style="rounded,filled", fontname="Arial", fontsize=11, color="#b6c7d8", fillcolor="#f3f7fb", margin="0.18,0.12"]; edge [color="#55738b", penwidth=1.5, arrowsize=0.8]; ehr [label="Synthetic EHR profile\nAge · diagnosis · HbA1c · history", fillcolor="#e8f1fb"]; cgm [label="Timestamped synthetic CGM stream\n15-minute readings", fillcolor="#e8f1fb"]; align [label="Data alignment & validation"]; features [label="Past-only rolling features\nCurrent value · changes · variability"]; model [label="Random Forest classifier\nFuture 120-minute threshold target", fillcolor="#dff3ec"]; eval [label="Patient-level holdout evaluation\nMetrics + all-negative baseline", fillcolor="#fff3d8"]; api [label="FastAPI service\nPatient · timeline · predict · replay · metrics", fillcolor="#e8f1fb"]; ui [label="Streamlit clinician dashboard\nPatient twin · timeline · forecast · replay", fillcolor="#dff3ec"]; safety [label="Synthetic data only · experimental output\nNot for clinical decision-making", fillcolor="#fff0ef", color="#e4aaa5"]; ehr -> align; cgm -> align; align -> features; features -> model; model -> eval; features -> api; model -> api; api -> ui; ui -> safety; }